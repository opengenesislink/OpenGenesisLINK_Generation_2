{
  "_note": "PLANNING EXAMPLE ONLY. No executable GridFabric server is currently published.",
  "GridFabric": {
    "PublicBaseUrl": "https://grid.example.org:8002",
    "Environment": "Production",
    "Cluster": {
      "Mode": "Standalone",
      "NodeId": "gridfabric-node-01"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "PublicHttps": {
        "Url": "https://0.0.0.0:8002",
        "Protocols": "Http1AndHttp2",
        "SslProtocols": [
          "Tls12",
          "Tls13"
        ],
        "Certificate": {
          "Path": "/etc/opengenesislink/gridfabric/tls/server.pfx"
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
